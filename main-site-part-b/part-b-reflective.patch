new file mode 100644
index 0000000..9e6eccc
--- /dev/null
+++ b/tests/play/handoff.test.mjs
@@ -0,0 +1,77 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createHmac } from "node:crypto";
+import { verifyHandoffToken } from "@/lib/play/handoff.js";
+
+const SECRET = "test-secret";
+const NOW = Date.parse("2026-10-07T12:00:00Z");
+const b64 = (o) => Buffer.from(typeof o === "string" ? o : JSON.stringify(o)).toString("base64url");
+
+function sign(claims, secret = SECRET, header = { alg: "HS256", typ: "JWT" }) {
+  const h = b64(header);
+  const b = b64(claims);
+  const s = createHmac("sha256", secret).update(`${h}.${b}`).digest("base64url");
+  return `${h}.${b}.${s}`;
+}
+
+const claims = (over = {}) => ({
+  sid: "3db872dc-8658-4839-be3e-f149fd13276c",
+  score: 700,
+  answered: 5,
+  correct: 3,
+  incorrect: 2,
+  completedAt: "2026-10-07T11:55:00.000Z",
+  nonce: "abc123",
+  exp: Math.floor(NOW / 1000) + 600,
+  ...over,
+});
+
+test("accepts a valid token", () => {
+  const r = verifyHandoffToken(sign(claims()), SECRET, NOW);
+  assert.equal(r.ok, true);
+  assert.equal(r.claims.score, 700);
+  assert.equal(r.claims.sid, "3db872dc-8658-4839-be3e-f149fd13276c");
+});
+
+test("accepts a negative score", () => {
+  assert.equal(verifyHandoffToken(sign(claims({ score: -300 })), SECRET, NOW).ok, true);
+});
+
+test("rejects a wrong secret and a tampered body", () => {
+  assert.equal(verifyHandoffToken(sign(claims(), "other"), SECRET, NOW).reason, "signature");
+  const [h, , s] = sign(claims()).split(".");
+  const forged = `${h}.${b64(claims({ score: 5000 }))}.${s}`;
+  assert.equal(verifyHandoffToken(forged, SECRET, NOW).reason, "signature");
+});
+
+test("rejects expired tokens", () => {
+  const t = sign(claims({ exp: Math.floor(NOW / 1000) - 1 }));
+  assert.equal(verifyHandoffToken(t, SECRET, NOW).reason, "expired");
+});
+
+test("rejects alg none and other algorithms", () => {
+  assert.equal(verifyHandoffToken(`${b64({ alg: "none" })}.${b64(claims())}.`, SECRET, NOW).ok, false);
+  assert.equal(verifyHandoffToken(sign(claims(), SECRET, { alg: "HS512" }), SECRET, NOW).reason, "malformed");
+});
+
+test("rejects missing, malformed and unconfigured", () => {
+  assert.equal(verifyHandoffToken("", SECRET, NOW).reason, "missing");
+  assert.equal(verifyHandoffToken(undefined, SECRET, NOW).reason, "missing");
+  assert.equal(verifyHandoffToken("a.b", SECRET, NOW).reason, "malformed");
+  assert.equal(verifyHandoffToken(sign(claims()), "", NOW).reason, "unconfigured");
+});
+
+test("rejects bad claims", () => {
+  for (const over of [
+    { sid: "not-a-uuid" },
+    { answered: 11, correct: 6, incorrect: 5 },
+    { correct: 4 },
+    { score: 5001 },
+    { score: 1.5 },
+    { nonce: "" },
+    { completedAt: "nope" },
+    { completedAt: "2026-10-08T12:00:00.000Z" },
+  ]) {
+    assert.equal(verifyHandoffToken(sign(claims(over)), SECRET, NOW).reason, "claims", JSON.stringify(over));
+  }
+});
