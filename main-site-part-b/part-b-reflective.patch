+"use client";
+
+import { useEffect, useRef, useState } from "react";
+import Link from "next/link";
+import { PLAY_GAME_URL } from "@/lib/play/config";
+import styles from "./ClaimRunner.module.css";
+
+export default function ClaimRunner({ token }) {
+  const [state, setState] = useState({ status: "saving" });
+  const started = useRef(false);
+
+  useEffect(() => {
+    if (started.current) return;
+    started.current = true;
+    (async () => {
+      try {
+        const res = await fetch("/api/play/claim", {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify({ token }),
+        });
+        const data = await res.json();
+        if (res.ok) setState({ status: "done", ...data });
+        else setState({ status: "error", message: data.message ?? "Could not save your score." });
+      } catch {
+        setState({ status: "error", message: "No connection. Check your signal and try again." });
+      }
+    })();
+  }, [token]);
+
+  if (state.status === "saving") {
+    return <p className={styles.lead} role="status">Saving your score</p>;
+  }
+
+  if (state.status === "error") {
+    return (
+      <div>
+        <p className={styles.lead}>{state.message}</p>
+        <div className={styles.actions}>
+          <a href={PLAY_GAME_URL} className={styles.primary}>Play again</a>
+          <Link href="/films" className={styles.secondary}>Watch the films</Link>
+        </div>
+      </div>
+    );
+  }
+
+  return (
+    <div>
+      <p className={styles.kicker}>{state.alreadyClaimed ? "Already saved" : "Saved"}</p>
+      <p className={styles.score}>{state.score}</p>
+      <p className={styles.sub}>
+        {state.correct} correct from {state.answered} questions
+      </p>
+      <p className={styles.lead}>
+        {state.alreadyClaimed
+          ? "This score was already on your account."
+          : state.counted
+            ? "This is your counted score for today. It is on the leaderboard."
+            : "Your first score each day is the one that counts. Play again tomorrow for another go."}
+      </p>
+      <div className={styles.actions}>
+        <Link href="/play" className={styles.primary}>See the leaderboard</Link>
+        <a href={PLAY_GAME_URL} className={styles.secondary}>Play again</a>
+        <Link href="/films" className={styles.secondary}>Watch the films</Link>
+        <Link href="/ultima" className={styles.secondary}>Play Ultima</Link>
+      </div>
+    </div>
+  );
+}
