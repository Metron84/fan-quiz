+++ b/app/api/play/claim/route.js
@@ -0,0 +1,74 @@
+import { NextResponse } from "next/server";
+import { createClient } from "@/lib/supabase/server";
+import { getServiceClient } from "@/lib/supabase";
+import { verifyHandoffToken } from "@/lib/play/handoff";
+
+export const dynamic = "force-dynamic";
+
+const MESSAGES = {
+  unconfigured: "Saving scores is not available right now. Try again soon.",
+  missing: "That link is missing its score. Play again to get a new one.",
+  malformed: "That link did not work. Play again to get a new one.",
+  signature: "That link did not work. Play again to get a new one.",
+  claims: "That link did not work. Play again to get a new one.",
+  expired: "That link has expired. Play again to get a fresh one.",
+};
+
+export async function POST(request) {
+  const supabase = await createClient();
+  const service = getServiceClient();
+  if (!supabase || !service) {
+    return NextResponse.json({ message: "Not configured." }, { status: 503 });
+  }
+
+  const {
+    data: { user },
+  } = await supabase.auth.getUser();
+  if (!user) {
+    return NextResponse.json({ message: "Sign in to save your score.", reason: "auth" }, { status: 401 });
+  }
+
+  let body;
+  try {
+    body = await request.json();
+  } catch {
+    return NextResponse.json({ message: MESSAGES.malformed, reason: "malformed" }, { status: 400 });
+  }
+
+  const check = verifyHandoffToken(body?.token, process.env.PLAY_HANDOFF_SECRET);
+  if (!check.ok) {
+    const status = check.reason === "unconfigured" ? 503 : 400;
+    return NextResponse.json({ message: MESSAGES[check.reason], reason: check.reason }, { status });
+  }
+  const c = check.claims;
+
+  const { data, error } = await service.rpc("fan_quiz_claim", {
+    p_user: user.id,
+    p_session: c.sid,
+    p_score: c.score,
+    p_answered: c.answered,
+    p_correct: c.correct,
+    p_incorrect: c.incorrect,
+    p_completed: c.completedAt,
+  });
+  const row = Array.isArray(data) ? data[0] : data;
+  if (error || !row) {
+    return NextResponse.json({ message: "Could not save your score. Try again." }, { status: 500 });
+  }
+  if (row.out_user_id !== user.id) {
+    return NextResponse.json(
+      { message: "That score is already saved to another account.", reason: "taken" },
+      { status: 409 }
+    );
+  }
+
+  return NextResponse.json({
+    ok: true,
+    score: row.out_score,
+    answered: row.out_answered,
+    correct: row.out_correct,
+    incorrect: row.out_incorrect,
+    counted: row.out_counted,
+    alreadyClaimed: row.out_already_claimed,
+  });
+}
