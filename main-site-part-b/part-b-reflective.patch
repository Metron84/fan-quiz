+export const dynamic = "force-dynamic";
+
+const PROBLEMS = {
+  unconfigured: "Saving scores is not available right now. Try again soon.",
+  expired: "That link has expired. Play again to get a fresh one.",
+  missing: "That link is missing its score. Play again to get a new one.",
+  default: "That link did not work. Play again to get a new one.",
+};
+
+export default async function ClaimPage({ searchParams }) {
+  const params = await searchParams;
+  const token = typeof params?.t === "string" ? params.t : "";
+  const check = verifyHandoffToken(token, process.env.PLAY_HANDOFF_SECRET);
+
+  if (!check.ok) {
+    return (
+      <div className={styles.page}>
+        <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Play", href: "/play" }, { label: "Save score" }]} />
+        <div className={styles.inner}>
+          <SectionHeader eyebrow="Are You Really a Fan?" title="Save your score" />
+          <p className={styles.note}>{PROBLEMS[check.reason] ?? PROBLEMS.default}</p>
+          <div className={styles.actions}>
+            <a href={PLAY_GAME_URL} className={styles.primary}>Back to the game</a>
+            <Link href="/play" className={styles.secondary}>See the leaderboard</Link>
+            <Link href="/films" className={styles.secondary}>Watch the films</Link>
+          </div>
+        </div>
+      </div>
+    );
+  }
+
+  // Signed out: through the existing sign-in wall, then straight back to this URL.
+  const user = await getSessionUser();
+  if (!user) {
+    redirect(`/signin?next=${encodeURIComponent(`/play/claim?t=${token}`)}`);
+  }
+
+  return (
+    <div className={styles.page}>
+      <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Play", href: "/play" }, { label: "Save score" }]} />
+      <div className={styles.inner}>
+        <SectionHeader eyebrow="Are You Really a Fan?" title="Save your score" />
+        <ClaimRunner token={token} />
+      </div>
+    </div>
+  );
+}
